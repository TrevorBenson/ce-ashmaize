# Containerfile with CUDA support for GPU-accelerated Ashmaize solver (Fedora-based)
# Use NVIDIA CUDA base image with Fedora
# Note: Using CUDA 12.6 as cudarc 0.12.x doesn't support CUDA 13.x yet
FROM docker.io/nvidia/cuda:12.6.0-devel-fedora39

# Install Rust and build tools
RUN dnf -y install curl cargo jq git rust-src gcc gcc-c++ make

# Install uv for Python
RUN curl -LsSf https://astral.sh/uv/install.sh | sh

# Copy local repository (with CUDA 13.0 changes)
# NOTE: Run from repository root: cd /home/illuminatus/Projects/ce-ashmaize && podman build -f cli_hunt/Containerfile.cuda -t ashmaize-solver:cuda12-fedora .
WORKDIR /app/ce-ashmaize
COPY . .

# Build Rust solver WITH CUDA support
RUN cd cli_hunt/rust_solver \
    && cargo build --release --features cuda

# Setup Python orchestrator
RUN cd cli_hunt/python_orchestrator \
    && ~/.local/bin/uv sync

# Set working directory
WORKDIR /app/ce-ashmaize/cli_hunt

# Add CUDA to PATH (should already be set in base image, but ensure it)
ENV PATH="/usr/local/cuda/bin:${PATH}"
ENV LD_LIBRARY_PATH="/usr/local/cuda/lib64:${LD_LIBRARY_PATH}"

# Default command - run solver help to verify build
CMD ["/app/ce-ashmaize/cli_hunt/rust_solver/target/release/ashmaize-solver", "--help"]

